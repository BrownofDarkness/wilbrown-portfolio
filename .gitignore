# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but always commit the template so contributors know which vars to set
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal planning docs (do not publish)
PORTFOLIO_CONTEXT.md
CV_DJOUTOP_TAKOU_Wilfried_Brown.pdf

# Claude Code local config
.claude/

# IDE project files (PhpStorm / WebStorm)
.idea/
*.iml

# Phase 4 — Showcase backend
# SQLite database (lives on VPS filesystem; backup via cron)
/data/

# User-uploaded showcase images (resized via sharp at upload time)
/public/showcase/uploads/

# User-uploaded event photos (resized via sharp, organized per slug folder)
/public/events/uploads/

# Admin password hash file (preferred over env var to dodge dotenv $ interpolation)
/.auth/

# design references not for production
/design/

# generated tmp dirs
/_tmp/
/_portfolio_tmp/
