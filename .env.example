# ─── Contact form (Resend) ──────────────────────────────────────────────
# Required for the contact form to actually send emails.
# Without it, the form succeeds in "dry-run" mode (logs to console).
#
# 1. Sign up at https://resend.com (free tier: 3000 emails/month, 100/day)
# 2. Create an API key in the dashboard
# 3. Copy it below into your local .env.local (not this file)

RESEND_API_KEY=

# Optional. Defaults to "Portfolio <onboarding@resend.dev>".
# Override once you've verified your own domain in Resend.
# RESEND_FROM=Portfolio <hello@your-domain.tld>

# Optional. Defaults to the SITE.email constant in src/lib/constants.ts.
# Override to redirect form submissions to a different inbox (dev / staging).
# CONTACT_RECIPIENT=you@example.com

# ─── Admin auth (Phase 4 — Showcase + Events backoffice) ────────────────

# PREFERRED: store the bcrypt hash in .auth/password.hash (gitignored).
# Generate it interactively with:
#   npm run hash
# The file lookup runs BEFORE this env var, so this stays as a fallback
# only — useful for PaaS deploys where you can't easily ship a file.
ADMIN_PASSWORD_HASH=

# Random 64-char hex secret for signing the JWT session cookie.
# Generate via:
#   npm run secret
# CRITICAL: change this in production and rotate periodically.
AUTH_SECRET=

# Optional. Where to write the SQLite database file. Defaults to ./data/portfolio.db
# DB_PATH=./data/portfolio.db

# ─── Build metadata (Phase 5 — Footer live signature) ───────────────────
# These are auto-derived from git at build time. Only set them explicitly
# when deploying a tarball / extracted bundle without a .git directory
# (e.g. a CI-built artifact uploaded to a server).
#
# BUILD_HASH=abc1234
# BUILD_TIME=2026-05-27T15:30:00Z
